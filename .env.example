NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CLIPFORGE_DATA_DIR=./data
CLIPFORGE_MAX_UPLOAD_MB=2048
CLIPFORGE_MAX_DURATION_SECONDS=14400
# Optional local transcription / analysis model paths:
# CLIPFORGE_WHISPER_MODEL=C:/Models/faster-whisper-small
# CLIPFORGE_AI_CPU_THREADS=4
# Optional CUDA attempt using the same Whisper model; falls back to CPU INT8:
# CLIPFORGE_WHISPER_DEVICE=cuda
# CLIPFORGE_TRANSCRIPTION_MAX_SECONDS=5400
# CLIPFORGE_HIGHLIGHT_MODEL=C:/Models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# CLIPFORGE_LLM_RUNTIME=C:/path/to/node-llama-cpp/dist/index.js
# Optional full paths if FFmpeg is not on PATH:
# FFMPEG_BINARY=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BINARY=C:/tools/ffmpeg/bin/ffprobe.exe
# DATABASE_URL=postgresql+psycopg://user:password@localhost/clipforge
