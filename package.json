{
  "name": "clipforge-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "node node_modules/playwright/cli.js test",
    "test:visual": "node node_modules/playwright/cli.js test --grep visual",
    "verify:quick": "npm run typecheck && npm run lint && npm run test:unit",
    "verify": "npm run verify:quick && npm run test:api && npm run test:e2e && npm run build",
    "api": "python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8000",
    "test:api": "python -m pytest apps/api/tests -q",
    "fixtures": "python scripts/generate_test_media.py"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "vitest": "2.1.9",
    "prettier": "^3.4.0",
    "playwright": "1.57.0"
  }
}